# ATLAS Operator authorization
#
# The installer generates ATLAS_OPERATOR_TOKEN automatically.
# Never commit a real token.
ATLAS_OPERATOR_TOKEN=REPLACE_WITH_RANDOM_SECRET

# Operator execution is fail-closed.
#
# Empty allowlists mean ATLAS can investigate and propose,
# but cannot execute these infrastructure mutations.
ATLAS_OPERATOR_SYSTEMD_SERVICES=
ATLAS_OPERATOR_QEMU_VMIDS=
ATLAS_OPERATOR_LXC_VMIDS=
