# ATLAS OS runtime configuration
#
# State
ATLAS_DB_PATH=/var/lib/atlas/atlas.db

# Web console
#
# Safe public-install default:
# bind only to localhost until the administrator explicitly
# chooses to expose ATLAS on a trusted network.
ATLAS_WEB_HOST=127.0.0.1
ATLAS_WEB_PORT=8091

# Optional Ollama provider.
#
# ATLAS defaults to localhost:11434 when these are omitted.
# Uncomment when Ollama runs elsewhere.
#
# ATLAS_OLLAMA_HOST=127.0.0.1
# ATLAS_OLLAMA_PORT=11434

# Optional Proxmox provider.
#
# No Proxmox endpoint or credentials are configured by default.
#
# ATLAS_PROXMOX_URL=https://proxmox.example:8006
# ATLAS_PROXMOX_HOST=pve
# ATLAS_PROXMOX_TOKEN=PVEAPIToken=user@pam!atlas=replace-me
# ATLAS_PROXMOX_VERIFY_SSL=true
# ATLAS_PROXMOX_CA_BUNDLE=/etc/atlas/proxmox-ca.pem
